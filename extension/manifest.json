{
  "manifest_version": 3,
  "name": "Web Content Collector",
  "version": "1.0.0",
  "description": "Collect webpage content as Claude-ready Markdown, study-ready Word documents, or a full site kit to recreate the page. Captures embedded video links.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Web Content Collector",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/library/library.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "webNavigation",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "collect-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Collect this page (Markdown + study doc)"
    },
    "collect-site-kit": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Collect all elements to recreate this page (.zip)"
    }
  }
}
